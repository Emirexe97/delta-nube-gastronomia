# Plantilla sin secretos. NO usar en producción ni en el POS de caja.
# Copiar fuera del repositorio. Sólo se carga en el proceso de licencias de pruebas.
# No reemplaza la configuración aislada de DB_PATH, firma de licencias y panel.
# Mantener false hasta verificar la base nueva, las identidades y el HTTPS de pruebas.
MP_SANDBOX_ENABLED=false
# Rutas de ejemplo en la PC. En un contenedor usar rutas internas montadas de sólo lectura.
MP_SANDBOX_ACCESS_TOKEN_FILE=C:/Users/Emir/MP-Pruebas/access-token.txt
MP_SANDBOX_WEBHOOK_SECRET_FILE=C:/Users/Emir/MP-Pruebas/webhook-secret.txt
MP_SANDBOX_SELLER_ID=
MP_SANDBOX_BUYER_ID=
MP_SANDBOX_BUYER_EMAIL=
# Configurar URLs propias de staging. El webhook debe terminar en /billing/test/mercadopago/webhook.
MP_SANDBOX_BACK_URL=
MP_SANDBOX_NOTIFICATION_URL=
