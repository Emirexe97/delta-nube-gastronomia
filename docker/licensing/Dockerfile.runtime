# Artifacts must be built and tested locally before deployment.
FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392
ENV NODE_ENV=production PORT=8097 DB_PATH=/data/licenses.sqlite
WORKDIR /app
COPY packages/licensing/package.json ./node_modules/@gastronomy/licensing/package.json
COPY packages/licensing/dist ./node_modules/@gastronomy/licensing/dist
COPY apps/licensing-service/package.json ./apps/licensing-service/package.json
COPY apps/licensing-service/dist ./apps/licensing-service/dist
RUN mkdir -p /data && chown node:node /data
USER node
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD node -e "fetch('http://127.0.0.1:8097/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/licensing-service/dist/server.js"]
